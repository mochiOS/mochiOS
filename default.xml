<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote
            name="github"
            fetch="https://github.com/"
    />

    <remote
            name="sourceware"
            fetch="https://sourceware.org/git/"
    />

    <default
            remote="github"
            sync-c="true"
            sync-j="4"
    />

    <project
            name="mochiOS/boot"
            path="boot"
            revision="main"
    />

    <project
            name="mochiOS/mnu"
            path="core"
            revision="master"
    />

    <project
            name="mochiOS/syscalls"
            path="user"
            revision="main"
    />

    <project
            name="mochiOS/services"
            path="services"
            revision="main"
    />

    <project
            name="mochiOS/cexts"
            path="cexts"
            revision="main"
    />

    <project
            name="mochiOS/drivers"
            path="drivers"
            revision="main"
    />

    <project
            name="newlib-cygwin"
            path="libraries/newlib"
            remote="sourceware"
            revision="master"
    />

    <project
            path="libraries/rust"
            name="mochiOS/rust"
            revision="staging"
            remote="github"
    />

    <project
            path="libraries/libc"
            name="mochiOS/libc"
            revision="main"
            remote="github"
    />
</manifest>
