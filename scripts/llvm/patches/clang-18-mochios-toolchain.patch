+//===--- MochiOS.cpp - mochiOS ToolChain ---------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "MochiOS.h"
+#include "CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Driver/DriverDiagnostic.h"
+#include "clang/Driver/InputInfo.h"
+#include "clang/Driver/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/Process.h"
+
+using namespace clang;
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace llvm::opt;
+
+MochiOS::MochiOS(const Driver &D, const llvm::Triple &Triple,
+                 const ArgList &Args)
+    : ToolChain(D, Triple, Args) {
+  if (Triple.getArch() != llvm::Triple::x86_64 || Triple.isX32() ||
+      !Triple.isOSBinFormatELF())
+    D.Diag(diag::err_drv_clang_unsupported) << Triple.str();
+  getProgramPaths().push_back(D.getInstalledDir());
+  if (D.getInstalledDir() != D.Dir)
+    getProgramPaths().push_back(D.Dir);
+}
+
+// Match the ld driver's SDK precedence. Explicit sysroot can independently
+// select headers/libraries, while MOCHIOS_SDK still selects the CRT/runtime.
+std::string MochiOS::computeSDKRoot() const {
+  if (auto SDK = llvm::sys::Process::GetEnv("MOCHIOS_SDK"))
+    return SDK->empty() ? "." : *SDK;
+  const Driver &D = getDriver();
+  StringRef SysRoot(D.SysRoot);
+  while (SysRoot.size() > 1 && llvm::sys::path::is_separator(SysRoot.back()))
+    SysRoot = SysRoot.drop_back();
+  if (llvm::sys::path::filename(SysRoot) == "sysroot") {
+    StringRef Parent = llvm::sys::path::parent_path(SysRoot);
+    return Parent.empty() ? "." : std::string(Parent);
+  }
+  return std::string(llvm::sys::path::parent_path(D.Dir));
+}
+
+std::string MochiOS::computeSysRoot() const {
+  if (!getDriver().SysRoot.empty())
+    return getDriver().SysRoot;
+  SmallString<128> Path(computeSDKRoot());
+  llvm::sys::path::append(Path, "sysroot");
+  return std::string(Path);
+}
+
+Tool *MochiOS::buildLinker() const { return new tools::mochios::Linker(*this); }
+
+void MochiOS::AddClangSystemIncludeArgs(const ArgList &Args,
+                                        ArgStringList &CC1Args) const {
+  if (Args.hasArg(options::OPT_nostdinc))
+    return;
+  if (!Args.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> Path(getDriver().ResourceDir);
+    llvm::sys::path::append(Path, "include");
+    addSystemInclude(Args, CC1Args, Path);
+  }
+  if (!Args.hasArg(options::OPT_nostdlibinc)) {
+    SmallString<128> Path(computeSysRoot());
+    llvm::sys::path::append(Path, "include");
+    addSystemInclude(Args, CC1Args, Path);
+  }
+}
+
+void MochiOS::AddClangCXXStdlibIncludeArgs(const ArgList &Args,
+                                           ArgStringList &CC1Args) const {
+  if (Args.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc,
+                  options::OPT_nostdincxx))
+    return;
+  if (GetCXXStdlibType(Args) != CST_Libcxx) {
+    getDriver().Diag(diag::err_drv_unsupported_option_argument)
+        << "-stdlib=" << "libstdc++";
+    return;
+  }
+  SmallString<128> Path(computeSysRoot());
+  llvm::sys::path::append(Path, "include", "c++", "v1");
+  addSystemInclude(Args, CC1Args, Path);
+}
+
+void MochiOS::AddCXXStdlibLibArgs(const ArgList &Args,
+                                  ArgStringList &CmdArgs) const {
+  if (GetCXXStdlibType(Args) != CST_Libcxx) {
+    getDriver().Diag(diag::err_drv_unsupported_option_argument)
+        << "-stdlib=" << "libstdc++";
+    return;
+  }
+  CmdArgs.append(
+      {"--start-group", "-lc++", "-lc++abi", "-lunwind", "--end-group"});
+}
+
+void MochiOS::addClangTargetOptions(const ArgList &Args, ArgStringList &CC1Args,
+                                    Action::OffloadKind) const {
+  CC1Args.push_back("-nostdsysteminc");
+  if (!Args.hasFlag(options::OPT_mred_zone, options::OPT_mno_red_zone, false))
+    CC1Args.push_back("-disable-red-zone");
+}
+
+void tools::mochios::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                          const InputInfo &Output,
+                                          const InputInfoList &Inputs,
+                                          const ArgList &Args,
+                                          const char *LinkingOutput) const {
+  const auto &TC = static_cast<const toolchains::MochiOS &>(getToolChain());
+  const Driver &D = TC.getDriver();
+  // The ld driver publishes only a fully linked, signed and verified file. It
+  // owns failure cleanup; clang must not delete a previous output on failure.
+  C.forgetResultFile(&JA);
+  // Alternate backends belong behind the common driver, which always uses LLD
+  // and owns signing. --ld-path may explicitly locate that driver.
+  if (const Arg *A = Args.getLastArg(options::OPT_fuse_ld_EQ)) {
+    const StringRef Backend(A->getValue());
+    if (!Backend.empty() && Backend != "lld")
+      D.Diag(diag::err_drv_unsupported_opt_for_target)
+          << A->getAsString(Args) << TC.getTripleString();
+  }
+  ArgStringList CmdArgs;
+  CmdArgs.push_back(Args.MakeArgString("--mochios-sdk=" + TC.computeSDKRoot()));
+  CmdArgs.push_back(Args.MakeArgString("--sysroot=" + TC.computeSysRoot()));
+  Args.addAllArgs(
+      CmdArgs, {options::OPT_L, options::OPT_T_Group, options::OPT_u,
+                options::OPT_e, options::OPT_z, options::OPT_s, options::OPT_t,
+                options::OPT_r, options::OPT_static, options::OPT_shared,
+                options::OPT_pie, options::OPT_no_pie, options::OPT_nostdlib,
+                options::OPT_nostartfiles, options::OPT_nodefaultlibs});
+  if (Args.hasArg(options::OPT_static_pie))
+    CmdArgs.push_back("-pie");
+  if (const Arg *A = Args.getLastArg(options::OPT_rtlib_EQ)) {
+    const StringRef Value(A->getValue());
+    if (Value != "libgcc" && Value != "compiler-rt")
+      D.Diag(diag::err_drv_unsupported_option_argument) << "--rtlib=" << Value;
+    else
+      CmdArgs.push_back(Args.MakeArgString("--compiler-runtime=" + Value));
+  }
+  Args.claimAllArgs(options::OPT_pthread, options::OPT_pthreads);
+  tools::AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+  if (!Args.hasArg(options::OPT_r) && TC.ShouldLinkCXXStdlib(Args))
+    TC.AddCXXStdlibLibArgs(Args, CmdArgs);
+  CmdArgs.push_back("-o");
+  CmdArgs.push_back(Output.getFilename());
+  // Never inherit a build-host CLANG_DEFAULT_LINKER setting such as ld.lld.
+  const std::string Linker = Args.hasArg(options::OPT_ld_path_EQ)
+                                 ? TC.GetLinkerPath()
+                                 : TC.GetProgramPath("ld");
+  C.addCommand(std::make_unique<Command>(JA, *this, ResponseFileSupport::None(),
+                                         Args.MakeArgString(Linker), CmdArgs,
+                                         Inputs, Output));
+}
